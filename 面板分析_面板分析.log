. * 变量清单（对应 notebook cell 8 的三组清单）
. global cols_to_winsor   "tobinq subsidy rd lev cf salesq bm gm roe roa"

. global center_vars      "subsidy rd lev cf salesq roa gm roe bm"

. global interaction_vars "subsidy_rd subsidy_rd2 subsidy_lev rd_lev salesq_sub"

. 
. *==============================================================================
. * 工具程序 1：prepare_panel —— 对应 notebook 的 prepare_panel()
. *   用法：
. *     prepare_panel, winsor                                   // 只缩尾（cell 9）
. *     prepare_panel, impute(varlist) dropna(varlist)          // 完整流水线（cell 19/64）
. *     prepare_panel                                           // 只中心化+交互项（cell 41）
. *   要点：缩尾只对非缺失值做（notebook 特别强调：缺失值参与分位数会导致上侧不缩尾）。
. *==============================================================================
. capture program drop prepare_panel

. program define prepare_panel
  1.     syntax [, WInsor IMpute(varlist) DROPna(varlist) NoCenter]
  2. 
.     * (a) 1%/99% 缩尾
.     if "`winsor'" != "" {
  3.         foreach v of global cols_to_winsor {
  4.             quietly summarize `v', detail
  5.             local lo = r(p1)
  6.             local hi = r(p99)
  7.             quietly replace `v' = `lo' if !missing(`v') & `v' < `lo'
  8.             quietly replace `v' = `hi' if !missing(`v') & `v' > `hi'
  9.         }
 10.         display "  [prepare_panel] 已完成 1%/99% 缩尾（只对非缺失值）"
 11.     }
 12. 
.     * (b) 企业内线性插值（TobinQ 不插值；不用未来值回填过去）
.     *     对应 pandas: groupby('Code')[cols].transform(
.     *         lambda x: x.interpolate(method='linear', limit_direction='forward'))
.     *     即：中间缺口线性插值，尾部缺口用最近的前值填补，首部缺口保持缺失。
.     *     注意插值间距：pandas 是按行号（reset_index 后的 RangeIndex）计算间距的，
.     *     不是按自然时间；因此这里同样按"企业内行号"插值，保证与 notebook 完全一致
.     *     （只有存在整段缺失行的企业，如 LEAPMOTOR，两种口径才会有差别）。
.     if "`impute'" != "" {
 13.         capture drop __rowid
 14.         quietly bysort panel_id (time): gen long __rowid = _n
 15.         foreach v of varlist `impute' {
 16.             capture drop __ip
 17.             capture ipolate `v' __rowid, gen(__ip) by(panel_id)
 18.             capture quietly replace `v' = __ip if missing(`v') & !missing(__ip)
 19.             capture drop __ip
 20.             forvalues k = 1/40 {
 21.                 capture quietly bysort panel_id (time): replace `v' = `v'[_n-1] if missing(`v')
 22.             }
 23.         }
 24.         capture drop __rowid
 25.         display "  [prepare_panel] 已完成企业内线性插值（TobinQ 与被解释变量除外）"
 26.     }
 27. 
.     * (c) 剔除仍然不完整的观测（必须在中心化之前，保证 *_c 均值严格为 0）
.     if "`dropna'" != "" {
 28.         quietly egen __rowmiss = rowmiss(`dropna')
 29.         quietly drop if __rowmiss > 0
 30.         capture drop __rowmiss
 31.         display "  [prepare_panel] 剔除不完整观测后 N = " _N
 32.     }
 33. 
.     * (d) 中心化  (e) 交互项（一律用中心化变量相乘：Aiken & West, 1991）
.     if "`nocenter'" == "" {
 34.         foreach v of global center_vars {
 35.             capture drop `v'_c
 36.             quietly egen __m = mean(`v')
 37.             quietly gen `v'_c = `v' - __m
 38.             capture drop __m
 39.         }
 40.         foreach v of global interaction_vars {
 41.             capture drop `v'
 42.         }
 43.         quietly gen subsidy_rd  = subsidy_c * rd_c
 44.         quietly gen subsidy_rd2 = subsidy_c * rd_c^2
 45.         quietly gen subsidy_lev = subsidy_c * lev_c
 46.         quietly gen rd_lev      = rd_c * lev_c
 47.         quietly gen salesq_sub  = salesq_c * subsidy_c
 48.         * 交互项自身再中心化（供需要 *_c 版交互项的模型使用）
.         foreach v of global interaction_vars {
 49.             capture drop `v'_c
 50.             quietly egen __m = mean(`v')
 51.             quietly gen `v'_c = `v' - __m
 52.             capture drop __m
 53.         }
 54.         display "  [prepare_panel] 已完成中心化与交互项构建"
 55.     }
 56. end

. 
. *==============================================================================
. * 工具程序 2：show_models —— 输出已存储模型的对比表
. *   有 esttab 时输出 rtf 表 + 屏幕表；没有时退回 estimates table
. *==============================================================================
. capture program drop show_models

. program define show_models
  1.     syntax anything [, TItle(string) FIle(string) MTitles(string) KEEP(string)]
  2.     local mtopt ""
  3.     if "`mtitles'" != "" local mtopt `"mtitles(`mtitles')"'
  4.     local keepopt ""
  5.     if "`keep'" != "" local keepopt "keep(`keep')"
  6.     display _n(2) "=============== 表：`title' ==============="
  7.     if "$have_esttab" == "1" {
  8.         if "`file'" != "" {
  9.             esttab `anything' using "`file'", replace b(4) se(4) ///
>                 star(* 0.1 ** 0.05 *** 0.01) nogap compress title("`title'") ///
>                 `mtopt' `keepopt'
 10.         }
 11.         else {
 12.             esttab `anything', b(4) se(4) star(* 0.1 ** 0.05 *** 0.01) ///
>                 nogap compress title("`title'") `mtopt' `keepopt'
 13.         }
 14.     }
 15.     else {
 16.         estimates table `anything', b(%9.4f) star(0.10 0.05 0.01) ///
>             stats(N r2_w r2_o F) `keepopt'
 17.     }
 18. end

. 
. *==============================================================================
. * 工具程序 3：vif_table —— 计算方差膨胀因子
. *   VIF_j = 1/(1-R²_j)，R²_j 来自"把第 j 个解释变量对其余解释变量回归"；
. *   所有辅助回归都限制在"全部变量均不缺失"的同一样本上，
. *   与 notebook 中 variance_inflation_factor 在同一个 .dropna() 矩阵上的算法等价。
. *==============================================================================
. capture program drop vif_table

. program define vif_table
  1.     local all `*'
  2.     quietly egen __okrow = rowmiss(`all')
  3.     quietly count if __okrow == 0
  4.     display "  （VIF 计算样本：N = " r(N) "）"
  5.     display "  变量              VIF        1/VIF      判断"
  6.     foreach x of local all {
  7.         local others : list all - x
  8.         quietly regress `x' `others' if __okrow == 0
  9.         scalar __vif = 1/(1 - e(r2))
 10.         local flag "无共线性"
 11.         if __vif >= 5  local flag "中度共线"
 12.         if __vif >= 10 local flag "严重共线"
 13.         display "  " %-14s "`x'" %9.3f scalar(__vif) %11.3f scalar(1/__vif) "      `flag'"
 14.     }
 15.     capture drop __okrow
 16. end

. 
