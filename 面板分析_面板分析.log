. matrix Ev2 = e(Ev)

. matrix L   = e(L)

. * 载荷 = 单位特征向量 × √特征值（逐列缩放；这里只保留已提取的前 ncomp 个主成分）
. local nkeep = colsof(L)

. matrix D = J(`nkeep', `nkeep', 0)

. forvalues j = 1/`nkeep' {
  2.     matrix D[`j', `j'] = sqrt(Ev2[1, `j'])
  3. }

. matrix LOAD = L * D

